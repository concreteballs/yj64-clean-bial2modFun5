                    while True:
                        chunk = source.read(65536)
                        if not chunk:
                            break
                        for value_byte in chunk:
                            output.write(value_byte)
                        copied += len(chunk)
                output.flush()
            finally:
                output.close()
            if copied != source_path.stat().st_size or copied <= 0:
                raise IOError("Private archive write size mismatch")
            readback = resolver.openInputStream(uri)
