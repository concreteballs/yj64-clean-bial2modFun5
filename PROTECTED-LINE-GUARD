"""Authenticated, bounded, idempotent Base -> Monitor report transport."""
from __future__ import annotations

import json
import re
import time
import uuid
from typing import Any

SCHEMA = "yj64.diagnostic.v1"
MAX_REPORT_BYTES = 64 * 1024
SAFE_ID = re.compile(r"^[A-Za-z0-9_-]{8,80}$")
ALLOWED_TOP = {"schema", "agent", "event", "timestamp_ms", "report_id", "data"}
FORBIDDEN_KEYS = {
    "api_key", "token", "access_token", "refresh_token", "authorization",
    "private_messages", "message_content", "chat_history", "prompt",
}


def _clean(value: Any, depth: int = 0) -> Any:
    if depth > 8:
        raise ValueError("payload nesting limit exceeded")
    if isinstance(value, dict):
        out = {}
        for key, item in value.items():
            name = str(key)
            if name.lower() in FORBIDDEN_KEYS:
                continue
            out[name[:80]] = _clean(item, depth + 1)
        return out
    if isinstance(value, list):
        if len(value) > 256:
            raise ValueError("payload list limit exceeded")
        return [_clean(x, depth + 1) for x in value]
    if isinstance(value, str):
        return value[:4096]
    if value is None or isinstance(value, (bool, int, float)):
        return value
    raise TypeError("unsupported diagnostic payload type")


def validate_report(report: dict[str, Any]) -> dict[str, Any]:
    if not isinstance(report, dict) or set(report) - ALLOWED_TOP:
        raise ValueError("invalid report envelope")
    if report.get("schema") != SCHEMA:
        raise ValueError("unsupported diagnostic schema")
    if not SAFE_ID.fullmatch(str(report.get("report_id", ""))):
        raise ValueError("invalid report_id")
    if not str(report.get("event", "")).strip():
        raise ValueError("event is required")
    data = _clean(report.get("data", {}))
    result = {
        "schema": SCHEMA,
        "agent": str(report.get("agent", "yj64-base-application"))[:80],
        "event": str(report["event"])[:120],
        "timestamp_ms": int(report.get("timestamp_ms") or time.time() * 1000),
        "report_id": str(report["report_id"]),
        "data": data,
    }
    encoded = json.dumps(result, ensure_ascii=False, separators=(",", ":")).encode()
    if len(encoded) > MAX_REPORT_BYTES:
        raise ValueError("diagnostic report exceeds size limit")
    return result


class BaseToMonitorClient:
    """Thin Android ContentResolver client; provider performs caller checks."""

    def __init__(self, context: Any, authority: str):
        self.context = context
        self.authority = authority

    def deliver(self, report: dict[str, Any]) -> dict[str, Any]:
        clean = validate_report(report)
        from jnius import autoclass
        Uri = autoclass("android.net.Uri")
        Bundle = autoclass("android.os.Bundle")
        extras = Bundle()
        extras.putString("report_json", json.dumps(clean, ensure_ascii=False))
        result = self.context.getContentResolver().call(
            Uri.parse("content://" + self.authority),
            "receive_report", None, extras
        )
        if result is None:
            raise RuntimeError("monitor provider returned no acknowledgement")
        accepted = bool(result.getBoolean("ok", False))
        ack_id = str(result.getString("report_id") or "")
        if not accepted or ack_id != clean["report_id"]:
            raise RuntimeError(
                str(result.getString("error") or "monitor acknowledgement mismatch")
            )
        return {"ok": True, "report_id": ack_id}


def new_report(event: str, **data: Any) -> dict[str, Any]:
    return validate_report({
        "schema": SCHEMA,
        "agent": "yj64-base-application",
        "event": event,
        "timestamp_ms": int(time.time() * 1000),
        "report_id": uuid.uuid4().hex,
        "data": data,
    })
