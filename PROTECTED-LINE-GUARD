    def _publish_private_zip_to_downloads(
        self, source_path: Path, display_name: str
    ) -> int:
        import zipfile
        from jnius import autoclass

        PythonActivity = autoclass("org.kivy.android.PythonActivity")
        ContentValues = autoclass("android.content.ContentValues")
        MediaStoreDownloads = autoclass("android.provider.MediaStore$Downloads")
        resolver = PythonActivity.mActivity.getContentResolver()
        uri = None
        verify_path = source_path.with_name(source_path.stem + "-readback.zip")
        try:
            values = ContentValues()
            values.put("display_name", display_name)
            values.put("mime_type", "application/zip")
            values.put("relative_path", "Download/YJ-64/")
            values.put("is_pending", 1)
            uri = resolver.insert(MediaStoreDownloads.EXTERNAL_CONTENT_URI, values)
            if uri is None:
                raise IOError("MediaStore did not create private archive")
            output = resolver.openOutputStream(uri)
            if output is None:
                raise IOError("MediaStore output stream unavailable")
            source_digest = hashlib.sha256(source_path.read_bytes()).hexdigest()
            copied = 0
