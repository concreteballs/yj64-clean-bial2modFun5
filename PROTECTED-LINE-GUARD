"""Explicit context selection with no silent truncation or mode fallback."""
from __future__ import annotations

import math
from typing import Any, Callable, Iterable


class ContextBudgetError(ValueError):
    pass


class ContextManager:
    MODES = frozenset({"memory_only", "memory_recent", "full_history"})

    def __init__(self, token_counter: Callable[[str], int]) -> None:
        if not callable(token_counter):
            raise ValueError("A provider-compatible token_counter is required")
        self.token_counter = token_counter

    def build(
        self,
        *,
        mode: str,
        token_budget: int,
        memory_items: Iterable[dict[str, Any]],
        recent_messages: Iterable[dict[str, Any]],
        full_history: Iterable[dict[str, Any]],
        participant_id: str | None,
        transport_mode: str,
    ) -> dict[str, Any]:
        if mode not in self.MODES:
            raise ValueError("Unknown context mode")
        if isinstance(token_budget, bool) or not isinstance(token_budget, int) or token_budget <= 0:
            raise ValueError("token_budget must be a positive integer")
        if transport_mode not in ("text", "agent"):
            raise ValueError("Unknown transport/API mode")
        memories = [
            dict(item) for item in memory_items
            if isinstance(item, dict)
            and item.get("status", "active") == "active"
            and item.get("participant_id") == participant_id
        ]
        recent = [dict(item) for item in recent_messages if isinstance(item, dict)]
        history = [dict(item) for item in full_history if isinstance(item, dict)]

        memory_layer = [
            {
                "role": "system",
                "content": (
                    "[SEMANTIC_MEMORY] " + str(item.get("type", "memory"))
                    + ": " + str(item.get("text", ""))
                ),
                "provenance": {
                    "source": "semantic_memory",
                    "memory_id": str(item.get("id", "")),
                    "source_message_ids": list(item.get("source_message_ids") or []),
                    "scope": item.get("scope"),
                    "confidence": item.get("confidence"),
                },
            }
            for item in memories
        ]

        def count(rows: list[dict[str, Any]]) -> int:
            return sum(
                max(0, int(self.token_counter(str(row.get("content", "")))))
                for row in rows
            )

        if mode == "memory_only":
            selected = memory_layer
        elif mode == "full_history":
            selected = history
        else:
            selected = list(memory_layer)
            used = count(selected)
            if used > token_budget:
                raise ContextBudgetError(
                    "Semantic memory alone exceeds the configured context budget"
                )
            selected_recent = []
            for message in reversed(recent):
                candidate = selected_recent + [message]
                if used + count(candidate) > token_budget:
                    break
                selected_recent = candidate
            selected.extend(selected_recent)

        used = count(selected)
        if used > token_budget:
            raise ContextBudgetError(
                f"Selected context requires {used} tokens; budget is {token_budget}"
            )
        return {
            "context_mode": mode,
            "transport_mode": transport_mode,
            "participant_id": participant_id,
            "estimated_or_provider_tokens": used,
            "token_budget": token_budget,
            "messages": selected,
            "provenance": [
                dict(row.get("provenance") or {"source": "history"})
                for row in selected
            ],
        }


