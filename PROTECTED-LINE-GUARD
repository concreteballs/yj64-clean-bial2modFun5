"""Allowlisted Monitor -> Base command request client."""
from __future__ import annotations

import json
import re
import time
import uuid
from typing import Any

PROTOCOL = "yj64.monitor-command.v1"
MAX_REQUEST_BYTES = 16 * 1024
ALLOWED_COMMANDS = {
    "get_status",
    "request_report_flush",
    "request_diagnostic_snapshot",
}
ID_RE = re.compile(r"^[a-f0-9]{32}$")


def make_request(command: str, args: dict[str, Any] | None = None) -> dict[str, Any]:
    if command not in ALLOWED_COMMANDS:
        raise ValueError("command is not allowlisted")
    if args is not None and not isinstance(args, dict):
        raise TypeError("args must be an object")
    request = {
        "protocol": PROTOCOL,
        "request_id": uuid.uuid4().hex,
        "command": command,
        "created_ms": int(time.time() * 1000),
        "args": args or {},
    }
    raw = json.dumps(request, separators=(",", ":"), ensure_ascii=False).encode()
    if len(raw) > MAX_REQUEST_BYTES:
        raise ValueError("request too large")
    return request


class MonitorToBaseClient:
    def __init__(self, context: Any, authority: str):
        self.context, self.authority = context, authority

    def call(self, command: str, args: dict[str, Any] | None = None) -> dict[str, Any]:
        from jnius import autoclass
        request = make_request(command, args)
        Uri = autoclass("android.net.Uri")
        Bundle = autoclass("android.os.Bundle")
        extras = Bundle()
        extras.putString("request_json", json.dumps(request))
        result = self.context.getContentResolver().call(
            Uri.parse("content://" + self.authority),
            "execute_command", None, extras
        )
        if result is None or not result.getBoolean("ok", False):
            raise RuntimeError("Base rejected or did not acknowledge command")
        if str(result.getString("request_id") or "") != request["request_id"]:
            raise RuntimeError("Base command acknowledgement mismatch")
        payload = result.getString("result_json") or "{}"
        decoded = json.loads(str(payload))
        if not isinstance(decoded, dict):
            raise RuntimeError("invalid Base command response")
        return decoded
