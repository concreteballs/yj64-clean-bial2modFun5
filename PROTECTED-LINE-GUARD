"""Default-deny permission checks for YJ-64 protected operations."""
from __future__ import annotations

import json
import os
import tempfile
import time
import uuid
from pathlib import Path
from threading import RLock
from typing import Any

class PermissionDenied(PermissionError):
    pass


class PermissionManager:
    VALID_SCOPES = {"common", "private", "owner", "participant", "diagnostics"}
    VALID_ACTIONS = {
        "chat.read", "chat.write", "private.read", "private.write",
        "archive.common.export", "archive.private.export",
        "archive.common.import", "archive.private.import",
        "skills.read", "skills.write", "router.configure",
        "participant.request", "system_chat.read", "system_chat.write",
        "memory.read", "memory.write", "diagnostics.read",
        "diagnostics.command",
    }

    def __init__(self, user_data_dir: str | Path, owner_id: str):
        self.root = Path(user_data_dir)
        self.owner_id = str(owner_id)
        self.path = self.root / "yj64-permissions.json"
        self.audit_path = self.root / "yj64-permission-audit.jsonl"
        self._lock = RLock()
        self.root.mkdir(parents=True, exist_ok=True)
        if not self.path.exists():
            self._atomic_write({"schema": "yj64.permissions.v1", "grants": []})

    @staticmethod
    def load_or_create_owner_id(user_data_dir: str | Path) -> str:
        root = Path(user_data_dir)
        root.mkdir(parents=True, exist_ok=True)
        path = root / "owner-identity.json"
        if path.exists():
            data = json.loads(path.read_text(encoding="utf-8"))
            value = str(data.get("owner_id", ""))
            if not value:
                raise RuntimeError("owner identity is invalid; refusing regeneration")
            return value
        value = uuid.uuid4().hex
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps({"schema": "yj64.owner.v1", "owner_id": value}),
                       encoding="utf-8")
        os.replace(tmp, path)
        return value

    def _read(self) -> dict[str, Any]:
        try:
            data = json.loads(self.path.read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            raise RuntimeError("permission store unreadable; default deny") from exc
        if not isinstance(data, dict) or data.get("schema") != "yj64.permissions.v1":
            raise RuntimeError("permission store invalid; default deny")
        grants = data.get("grants")
        if not isinstance(grants, list):
            raise RuntimeError("permission grants invalid; default deny")
        return data

    def _atomic_write(self, data: dict[str, Any]) -> None:
        fd, name = tempfile.mkstemp(prefix=".permissions-", dir=str(self.root))
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                json.dump(data, stream, ensure_ascii=False, indent=2)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(name, self.path)
        finally:
            if os.path.exists(name):
                os.unlink(name)

    def grant(self, subject_id: str, action: str, scope: str,
              granted_by: str) -> None:
        if action not in self.VALID_ACTIONS or scope not in self.VALID_SCOPES:
            raise ValueError("unknown permission action or scope")
        if granted_by != self.owner_id:
            raise PermissionDenied("only owner may change grants")
        if not subject_id:
            raise ValueError("subject_id required")
        with self._lock:
            data = self._read()
            rows = [x for x in data["grants"] if not (
                x.get("subject_id") == subject_id and x.get("action") == action
                and x.get("scope") == scope)]
            rows.append({"subject_id": subject_id, "action": action,
                         "scope": scope, "granted_by": granted_by,
                         "created_ms": int(time.time() * 1000)})
            data["grants"] = rows
            self._atomic_write(data)
        self._audit("grant", subject_id, action, scope, True)

    def revoke(self, subject_id: str, action: str, scope: str,
               revoked_by: str) -> None:
        if revoked_by != self.owner_id:
            raise PermissionDenied("only owner may revoke grants")
        with self._lock:
            data = self._read()
            data["grants"] = [x for x in data["grants"] if not (
                x.get("subject_id") == subject_id and x.get("action") == action
                and x.get("scope") == scope)]
            self._atomic_write(data)
        self._audit("revoke", subject_id, action, scope, True)

    def check(self, subject_id: str, action: str, scope: str,
              *, owner_action: bool = False) -> bool:
        allowed = False
        try:
            if action not in self.VALID_ACTIONS or scope not in self.VALID_SCOPES:
                raise PermissionDenied("unknown action or scope")
            if owner_action and subject_id == self.owner_id:
                allowed = True
            else:
                data = self._read()
                allowed = any(
                    x.get("subject_id") == subject_id
                    and x.get("action") == action and x.get("scope") == scope
                    and x.get("granted_by") == self.owner_id
                    for x in data["grants"] if isinstance(x, dict)
                )
            if not allowed:
                raise PermissionDenied(f"denied: {action} [{scope}]")
            return True
        finally:
            self._audit("check", subject_id, action, scope, allowed)

    def require(self, subject_id: str, action: str, scope: str,
                *, owner_action: bool = False) -> None:
        self.check(subject_id, action, scope, owner_action=owner_action)

    def _audit(self, operation: str, subject_id: str, action: str,
               scope: str, allowed: bool) -> None:
        row = {"timestamp_ms": int(time.time() * 1000),
               "operation": operation, "subject_id": str(subject_id)[:100],
               "action": action, "scope": scope, "allowed": bool(allowed)}
        self.audit_path.parent.mkdir(parents=True, exist_ok=True)
        with self.audit_path.open("a", encoding="utf-8") as stream:
            stream.write(json.dumps(row, ensure_ascii=False) + "\n")
