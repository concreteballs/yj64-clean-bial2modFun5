PROPOSED NEW FRAGMENT:
```python
                count = self.persistent_core.import_archive(temp_path)

                from chat_workspace import ChatWorkspace
                self.workspace = ChatWorkspace(self.user_data_dir)

                # Collect archived messages as model memory, not chat messages.
                restored_context = []
                seen_ids = set()

                for chat in self.workspace.list_chats():
                    chat_id = str(chat.get("id", ""))
                    if not chat_id:
                        continue

                    for item in self.workspace.load_messages(chat_id):
                        if not isinstance(item, dict):
                            continue

                        role = str(item.get("role", "")).lower()
                        content = str(item.get("content", "")).strip()

                        if role not in ("user", "assistant") or not content:
                            continue

                        message_id = str(item.get("message_id", "")).strip()
                        if message_id:
                            if message_id in seen_ids:
                                continue
                            seen_ids.add(message_id)

                        restored_context.append(dict(item))

                restored_context.sort(
                    key=lambda item: (
                        item.get("timestamp", item.get("timestamp_ms", 0)) or 0
                    )
                )

                context_path = (
                    self.workspace.root / "restored-model-context.json"
                )
                temp_context_path = context_path.with_suffix(".json.tmp")
                temp_context_path.write_text(
                    json.dumps(
                        restored_context,
                        ensure_ascii=False,
                        indent=2,
                    ),
                    encoding="utf-8",
                )
                temp_context_path.replace(context_path)

                self.restored_context_path = context_path
                self.restored_context_history = restored_context

                # Create a NEW empty visible chat.
                self.current_chat_id = self.workspace.create_chat(
                    "Новый чат после восстановления памяти"
                )
                self.common_history = []
                self.private_histories = {}

                if hasattr(self, "chat_output"):
                    self.chat_output.text = self._render_history()

                self.status.text = (
                    f"Память восстановлена: {len(restored_context)} сообщений. "
                    "Архив загружен в контекст моделей. "
                    "История не добавлена в текущий чат."
                )
                self._append_report(
                    "memory_archive_import_succeeded",
                    event_count=count,
                    restored_context_count=len(restored_context),
                    visible_chat_history_count=0,
                    archive=str(uri),
                    size_bytes=copied_bytes,
                )
