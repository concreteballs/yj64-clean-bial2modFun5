# Copy to .env on the host. Never commit real values.
# Keep 'supabase' for the current Edge Function + Supabase DB deployment.
YJ64_QUEUE_BACKEND=supabase
# For a standalone PostgreSQL deployment, set YJ64_QUEUE_BACKEND=postgres and DATABASE_URL.
DATABASE_URL=postgresql://yj64_worker:REPLACE_ME@127.0.0.1:5432/yj64
YJ64_DB_POOL_SIZE=12
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_SECRET
YJ64_COUNCIL_PROVIDER_CONFIG={"route_1":{"provider":"openai","model":"YOUR_MODEL","api_key":"REPLACE_ME","endpoint":"https://api.openai.com/v1"},"route_2":{"provider":"gemini","model":"YOUR_MODEL","api_key":"REPLACE_ME","endpoint":"https://generativelanguage.googleapis.com/v1beta"}}
YJ64_WORKER_POLL_SECONDS=3
YJ64_WORKER_LEASE_SECONDS=180
YJ64_WORKER_CONCURRENCY=2
