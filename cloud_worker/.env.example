# Copy to .env on the server. Never commit real values. chmod 600 .env

# Compose starts PostgreSQL on a private network with a persistent named volume.
YJ64_POSTGRES_DB=yj64
# Separate secrets: owner is only for DB administration; runtime is used by API/worker.
YJ64_POSTGRES_OWNER_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_OWNER_PASSWORD
YJ64_POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_RUNTIME_PASSWORD
YJ64_API_DB_POOL_SIZE=8
YJ64_DB_POOL_SIZE=12

# Intake remains CLOSED until authenticated live end-to-end verification.
YJ64_COUNCIL_ENGINE_ADAPTER=not_ready
YJ64_COUNCIL_WORKER_ENABLED=false

# Provider secrets are used only by the worker. At least two real routes are required.
YJ64_COUNCIL_PROVIDER_CONFIG={"route_1":{"provider":"openai","model":"YOUR_MODEL","api_key":"REPLACE_ME","endpoint":"https://api.openai.com/v1"},"route_2":{"provider":"gemini","model":"YOUR_MODEL","api_key":"REPLACE_ME","endpoint":"https://generativelanguage.googleapis.com/v1beta"}}

YJ64_WORKER_POLL_SECONDS=3
YJ64_WORKER_LEASE_SECONDS=180
YJ64_WORKER_CONCURRENCY=2
